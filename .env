# Twilio Configuration (Optional - for SMS/Call alerts)
# Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
USER_PHONE_NUMBER=+919876543210

# Google Gemini API (Optional - for Chatbot)
# Get from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key

# Tesseract OCR Path (Optional - for Walking Stability)
# Windows: C:\Users\YourUsername\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# Mac: /usr/local/bin/tesseract
TESSERACT_CMD=
